{
  "appId": "com.olzsen.moccount",
  "productName": "MoCcount",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "mac": {
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  },
  "publish": [
    {
      "provider": "github",
      "owner": "Olzsen",
      "repo": "MoCcount",
      "releaseType": "release"
    }
  ]
}
